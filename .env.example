# sec.gov rejects requests without a contact email in the User-Agent.
# Needed for insider trades (Form 4). Stays on your machine; .env is gitignored.
SEC_CONTACT_EMAIL=you@example.com

# Email (optional) -- for watchlist alerts and the Sunday digest. See mailer.py.
# For Gmail, use an App password, not your normal password.
SMTP_USER=
SMTP_PASSWORD=
EMAIL_TO=
